# Copie este arquivo para .env (mesma pasta) e preencha. O .env NUNCA vai para o git.
# Basta preencher as chaves dos provedores que você for testar.

GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Opcional (4º concorrente):
ANTHROPIC_API_KEY=

# Modelos (opcional). Confira na página de cada provedor se há versão mais nova/barata.
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-haiku-5-5

# Preços em US$ por 1 milhão de tokens (copie das páginas de preço). Opcional; habilita cálculo de custo.
# GEMINI_PRECO_ENTRADA=
# GEMINI_PRECO_SAIDA=
# DEEPSEEK_PRECO_ENTRADA=
# DEEPSEEK_PRECO_SAIDA=
# OPENAI_PRECO_ENTRADA=
# OPENAI_PRECO_SAIDA=
# ANTHROPIC_PRECO_ENTRADA=
# ANTHROPIC_PRECO_SAIDA=
